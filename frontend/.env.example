# API Base URL (leave empty for local dev with Vite proxy; set to your Render backend URL for Vercel deployment)
# Example for production: https://vani-2-poc-backend.onrender.com
VITE_API_BASE_URL=

# Optional: Dedicated WebSocket URL (if not set, automatically derived from VITE_API_BASE_URL using wss://)
# VITE_WS_BASE_URL=wss://vani-2-poc-backend.onrender.com
