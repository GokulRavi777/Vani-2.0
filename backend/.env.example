# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional LLM / Question Generation API Key
# If omitted or empty, the backend operates in deterministic fallback mode.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Future Audio & STT Provider Configuration (Stage 2+)
# Allowed values: google, sarvam, compare
DEFAULT_STT_MODE=google
GOOGLE_APPLICATION_CREDENTIALS=
SARVAM_API_KEY=

# Gnani AI Configuration (Official pipecat-gnani STT & TTS integration)
GNANI_API_KEY=
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_VOICE_CLONE_MODEL=vachana-vc-v1
GNANI_VOICE_CLONE_EMBEDDINGS_ENDPOINT=https://api.vachana.ai/api/v1/tts/voice-clone/embeddings
GNANI_DEFAULT_VOICE=Pranav
GNANI_DEFAULT_LANGUAGE=en-IN
